{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-db.mjs",
    "db:migrate": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/run-sql.mjs",
    "db:check-schema": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-schema.mjs",
    "db:seed:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON supabase/seed/generate.ts",
    "db:check-seed": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-seed.mjs",
    "ai:check": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-openai.mjs",
    "db:check-query": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-query.mjs",
    "chat:check": "node scripts/check-chat.mjs",
    "eval": "node scripts/run-eval.mjs",
    "db:set-agent-password": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/set-agent-password.mjs",
    "db:comments:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-comments.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "openai": "^7.47.0",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^65.9.0"
  }
}
